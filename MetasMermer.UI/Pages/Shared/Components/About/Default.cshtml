@model MetasMermer.Services.Abouts.AboutDto

<!-- About Section -->
<section id="about">
    <div class="about container">
        <div class="col-left">
            <div class="about-img">
                <img src="@Model.ImageLink[0].ToString()" alt="METAŞ MERMER">
            </div>
        </div>
        <div class="col-right">
            <h2 class="section-title">HAKKIMIZDA</h2>
            <h3>@Model.Title</h3>
            <p>
                @Model.Description
            </p>
            <a href="/Gallery" class="cta">Yaptığımız İşler</a>
        </div>
    </div>
</section>
<!-- End About Section -->