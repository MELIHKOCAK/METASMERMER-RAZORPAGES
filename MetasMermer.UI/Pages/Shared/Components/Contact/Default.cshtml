@model List<MetasMermer.Services.Contacts.ContactDto>

<!-- Contact Section -->
<section id="contact">
    <div style ="min-height:0vh;" class="contact container">
        <div>
            <h2 class="section-title">İLETİŞİM BİLGİLERİ</h2>
        </div>
        <div class="contact-items">
            <div class="contact-item">
                <div class="icon"><img src="/img/phone.svg" alt="İletişim Numarası" /></div>
                <div class="contact-info">
                    <h2>Telefon</h2>
                    <a href="tel:@Model[0].Value"><h3 style="padding-bottom: 5px ;">0 532 588 76 56</h3></a>
                    <hr style="height: 3px; background-color: black;">
                    <a href="tel:@Model[1].Value"><h3 style="padding-top: 5px ;">0 537 448 00 24</h3></a>
                </div>
            </div>
            <div class="contact-item">
                <div class="icon"><img src="/img/new-post.svg" alt="Mail Adresi" /></div>
                <div class="contact-info">
                    <h2>Mail Adresi</h2>
                    <a href="mailto:"@Model[2].Value"><h3>@Model[2].Value</h3></a>
                </div>
            </div>
            <div class="contact-item">
                <div class="icon"><img src="/img/map-marker.svg" alt="Adres, Konum" /></div>
                <div class="contact-info">
                    <h2>Adres</h2>
                    <a href="@Model[3].Value" target="_blank"><h3>@Model[4].Value</h3></a>
                </div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content:center;">
        <iframe style="max-width: 98vw; border:2px solid black;"
                src="@Model[5].Value"
                width="2500" height="450" allowfullscreen="" loading="lazy"></iframe>
    </div>
</section>