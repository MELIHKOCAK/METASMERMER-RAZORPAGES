<!DOCTYPE html>
<html lang="tr">
<head>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="canonical" href="https://metasmermer.net@(Context.Request.Path)" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="description" content="@ViewData["Description"]">
    <meta name="keywords" content="mermer tezgah, granit mutfak tezgahı, mutfak tezgahı, balkon mermeri, mermer ustası, niksar mermer, metaş mermer, niksar metaş mermer, niksar mezar çeşitleri, kaliteli mezar çeşitleri, kaliteli işcilik, mezar, tezgah, denizlik">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Metaş Mermer">
    <link rel="alternate" hreflang="tr-TR" href="https://metasmermer.net" />

    <meta property="og:title" content="Metaş Mermer - Kaliteli İşçilik, Uygun Fiyat" />
    <meta property="og:description" content="Mermer mezar, tezgah ve zemin döşeme işleriniz için profesyonel çözümler." />
    <meta property="og:image" content="https://metasmermer.net/img/anagoruntu.webp" />
    <meta property="og:url" content="https://metasmermer.net" />
    <meta property="og:type" content="website" />

    <environment include="Production">
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-BX01153Z7C"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-BX01153Z7C');
        </script>
    </environment>

</head>
<body>

    <partial name="_Navbar" />

    <!--External(RenderBody) Başlangıç-->
    <main role="main">
        @RenderBody()
    </main>
    <!--External(RenderBody) Son-->

    @await Component.InvokeAsync("Footer")
    @await Component.InvokeAsync("Whatsapp")

    <script src="~/javascript/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>

        /*Slider Başlangıç*/
        document.querySelectorAll(".img-slider").forEach((slider, sliderIndex) => {

            const slides = slider.querySelectorAll(".slide");
            const btns = slider.querySelectorAll(".btn");

            let currentSlide = 0;
            let autoSlideInterval;

            const SLIDE_TIME = 10000;              // 10 saniye
            const START_DELAY = sliderIndex * 2000; // Her slider 2 sn geç başlar

            function showSlide(index) {
            slides.forEach(slide => slide.classList.remove("active"));
            btns.forEach(btn => btn.classList.remove("active"));

            slides[index].classList.add("active");
            btns[index].classList.add("active");

            currentSlide = index;
            }

            function startAutoSlide() {
            autoSlideInterval = setInterval(() => {
                let next = (currentSlide + 1) % slides.length;
                showSlide(next);
            }, SLIDE_TIME);
            }

            function stopAutoSlide() {
            clearInterval(autoSlideInterval);
            }

            // Manuel kontrol → süre sıfırlanır
            btns.forEach((btn, index) => {
            btn.addEventListener("click", () => {
                stopAutoSlide();
                showSlide(index);
                startAutoSlide();
            });
            });

            setTimeout(() => {
            startAutoSlide();
            }, START_DELAY);

        });
        /*Slider Bitiş*/
    </script>
    <!--Javascript Son-->

</body>
</html>