<!DOCTYPE html>
<html lang="tr">
<head>
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
 @*    <link rel="preload" href="~/fonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin> *@
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="description" content="Niksarda mutfak ve balkonlarınız için özel tasarım mermerler. Niksarda yüksek kaliteli mermer tezgahlar ve balkon mermerlerinde uzman işçilik. Vefat etmiş sevdikleriniz için en iyi mezar çeşitleri burada.">
    <meta name="keywords" content="mermer tezgah, granit mutfak tezgahı, mutfak tezgahı, balkon mermeri, mermer ustası, niksar mermer, metaş mermer, niksar metaş mermer, niksar mezar çeşitleri, kaliteli mezar çeşitleri, kaliteli işcilik, mezar, tezgah, denizlik">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Metaş Mermer">
</head>
<body>

    <partial name="_Navbar" />

    <!--External(RenderBody) Başlangıç-->
    <main role="main">
        @RenderBody()
    </main>
    <!--External(RenderBody) Son-->

    @await Component.InvokeAsync("Footer")
    @await Component.InvokeAsync("Whatsapp")

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!--Javascript Son-->

</body>
</html>