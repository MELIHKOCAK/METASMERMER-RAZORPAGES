@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<style>
    #errorMain{
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        height: 100vh;
        width: 100vw;
        padding: 10%;
        gap: 3%;
    }
</style>

<div id="errorMain">
    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <p>
        <strong>Üzgünüz İsteğiniz İşlenirken Bir Hata Oluştu.</strong>
    </p>
</div>

