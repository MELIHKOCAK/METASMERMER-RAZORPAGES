@page
@model RazorPages.Deneme.Pages.Shared.GaleriModel
@{
    var link = Model.context.Galleries.ToList();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.8.2/css/lightbox.min.css">
<h1 style="text-align:center; margin: 90px 50px;">Yaptığımız işleri burada detaylı bir şekilde inceleyebilirsiniz.</h1>

<div class="photos-container">

    @foreach (var item in link)
    {
        <div class="item" style="height: 370px;">
            <picture>
                <source srcset="@item.ImageLink" type="image/webp">
                <a href="@item.ImageLink"
                   data-lightbox="photos">
                    <img class="img-fluid img" style="height: 100%;" src="@item.ImageLink">
                </a>
            </picture>
        </div>
    }

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.8.2/js/lightbox.min.js"></script>
