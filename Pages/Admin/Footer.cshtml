@page
@model RazorPages.Deneme.Pages.Admin.FooterModel
@{
    var footer = Model.context.Footer.FirstOrDefault();
}

<style>
    .mb20px {
        margin-bottom: 20px;
    }

    div#content {
        padding: 1vw;
    }

    input, select {
        width: 95%;
    }
</style>

<div id="content">
    <!-- Bu Template Üzerine Diğer Sayfalarınıda

    Tasarla Unutma Bir Form İçerisinde olmalılar. asp-for ve asp-page-handler tag helperlarını iyi araştır -->
    <form method="post">
        <div class="mb20px" id="mevcutDeger">
            <label for="">Current Facebook Link: " <a href="@footer.FacebookLink"><u>@footer.FacebookLink</u></a> "</label>
            <br />
            <label for="">Current Instagram Link: " <a href="@footer.InstagramLink"><u>@footer.InstagramLink</u></a> "</label>
        </div>
        <br />
        <div class="mb20px" id="yeniDeger">
            <label>New Facebook Link: </label>
            <br />
            <input asp-for="_NewFacebookLink" type="text" name="_NewFacebookLink" placeholder="Please enter your facebook link">
            <br />
            <label>New Instagram Link: </label>
            <br />
            <input asp-for="_NewInstagramLink" type="text" name="_NewInstagramLink" placeholder="Please enter your instagram link">
        </div>

        <div id="confirm">
            <input asp-page-handler="UpdateFooter" type="submit" id="cta" value="CONFIRM">
        </div>
    </form>
</div>

