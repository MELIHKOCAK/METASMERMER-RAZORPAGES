@page
@model RazorPages.Deneme.Pages.Admin.ContactModel
@{
    var contact = Model.context.Contact;
}
<style>
    .mb20px {
        margin-bottom: 20px;
    }

    div#content {
        padding: 1vw;
    }

    input, select {
        width: 95%;
    }

    u {
        white-space: normal;
        overflow-wrap: break-word;
        word-break: break-word;
        max-width: 100%;
    }
</style>

<div id="content">
    <!-- Bu Template Üzerine Diğer Sayfalarınıda

    Tasarla Unutma Bir Form İçerisinde olmalılar. asp-for ve asp-page-handler tag helperlarını iyi araştır -->
    <form method="post">
        <div class="mb20px" id="mevcutDeger">
            <label for="">Current First Phone Number: " <u>@contact.Find(1).Value</u> "</label>
            <br />
            <label for="">Current Second Phone Number " <u>@contact.Find(2).Value</u> "</label>
            <br />
            <label for="">Current Email Address: " <u>@contact.Find(3).Value</u> "</label>
            <br />
            <label for="">Current Map Link: " <u>@contact.Find(4).Value</u> "</label>
            <br />
            <label for="">Current Company Address: " <u>@contact.Find(5).Value</u> "</label>
            <br />
            <label for="">Current Map Embed Link: " <u>@contact.Find(6).Value</u> "</label>
            <br />
        </div>
        <br />
        <div class="mb20px" id="yeniDeger">
            <label>New First Phone Number:</label>
            <br />
            <input asp-for="_NewFirstNumber" type="text" name="_NewFirstNumber" placeholder="Please enter your First Phone Number">
            <br />
            <label>New Second Phone Number:</label>
            <br />
            <input asp-for="_NewSecondNumber" type="text" name="_NewSecondNumber" placeholder="Please enter your second phone number">
            <br />
            <label>New Email Address:</label>
            <br />
            <input asp-for="_NewEmailAddress" type="text" name="_NewEmailAddress" placeholder="Please enter your email address">
            <br />
            <label>New Map Link:</label>
            <br />
            <input asp-for="_NewMapLink" type="text" name="_NewMapLink" placeholder="Please enter your map link. My advice: you dont change this section">
            <br />
            <label>New Company Address:</label>
            <br />
            <input asp-for="_NewCompanyAddress" type="text" name="_NewCompanyAddress" placeholder="Please enter your company address">
            <br />
            <label>New Map Embed Link:</label>
            <br />
            <input asp-for="_NewMapEmbedLink" type="text" name="_NewMapEmbedLink" placeholder="Please enter your embed map link. My advice: you dont change this section">
        </div>
        <div id="confirm">
            <input asp-page-handler="UpdateContact" type="submit" id="cta" value="CONFIRM">
        </div>
    </form>
</div>
