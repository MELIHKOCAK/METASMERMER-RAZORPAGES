<!-- End Projects Section -->

<!-- About Section -->
<section id="about">
    <div class="about container">
        <div class="col-left">
            <div class="about-img">
                <img src="@about.ImageLink" alt="METAŞ MERMER">
            </div>
        </div>
        <div class="col-right">
            <h1 class="section-title">HAKKIMIZDA</h1>
            <h2>@about.Title</h2>
            <p>
                @about.Desc
            </p>
            <a href="/Galeri" class="cta">Yaptığımız İşler</a>
        </div>
    </div>
</section>
<!-- End About Section -->

<!-- Contact Section -->
<section id="contact">
    <div class="contact container">
        <div>
            <h1 class="section-title">İLETİŞİM BİLGİLERİ</h1>
        </div>
        <div class="contact-items">
            <div class="contact-item">
                <div class="icon"><img src="/img/phone.svg" alt="İletişim Numarası"/></div>
                <div class="contact-info">
                    <h1>Telefon</h1>
                    <a href="tel:@contactFirstPhoneNumber"><h2 style="padding-bottom: 5px ;">0 532 588 76 56</h2></a>
                    <hr style="height: 3px; background-color: black;">
                    <a href="tel:@contactSecondPhoneNumber"><h2 style="padding-top: 5px ;">0 537 448 00 24</h2></a>
                </div>
            </div>
            <div class="contact-item">
                <div class="icon"><img src="/img/new-post.svg" alt="Mail Adresi"/></div>
                <div class="contact-info">
                    <h1>Mail Adresi</h1>
                    <a href="mailto:"@contactMail""><h2>@contactMail</h2></a>
                </div>
            </div>
            <div class="contact-item">
                <div class="icon"><img src="/img/map-marker.svg" alt="Adres, Konum"/></div>
                <div class="contact-info">
                    <h1>Adres</h1>
                    <a href="@contactAddressUrl" target="_blank"><h2>@contactAddress</h2></a>
                </div>
            </div>
        </div>
    </div>
</section>

<div style="display: flex; justify-content:center;">
    <iframe style="max-width: 98vw; border:2px solid black;"
            src="@contactAddressMap"
            width="2500" height="450" allowfullscreen="" loading="lazy"></iframe>
</div>
<!-- End Contact Section -->

<script>

    /*Slider Başlangıç*/
    document.querySelectorAll(".img-slider").forEach((slider, sliderIndex) => {

        const slides = slider.querySelectorAll(".slide");
        const btns = slider.querySelectorAll(".btn");

        let currentSlide = 0;
        let autoSlideInterval;

        const SLIDE_TIME = 10000;              // 10 saniye
        const START_DELAY = sliderIndex * 2000; // Her slider 2 sn geç başlar

        function showSlide(index) {
        slides.forEach(slide => slide.classList.remove("active"));
        btns.forEach(btn => btn.classList.remove("active"));

        slides[index].classList.add("active");
        btns[index].classList.add("active");

        currentSlide = index;
        }

        function startAutoSlide() {
        autoSlideInterval = setInterval(() => {
            let next = (currentSlide + 1) % slides.length;
            showSlide(next);
        }, SLIDE_TIME);
        }

        function stopAutoSlide() {
        clearInterval(autoSlideInterval);
        }

        // Manuel kontrol → süre sıfırlanır
        btns.forEach((btn, index) => {
        btn.addEventListener("click", () => {
            stopAutoSlide();
            showSlide(index);
            startAutoSlide();
        });
        });

        setTimeout(() => {
        startAutoSlide();
        }, START_DELAY);

    });
    /*Slider Bitiş*/
</script>