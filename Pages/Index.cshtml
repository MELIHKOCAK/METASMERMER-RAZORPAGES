                        <img src="img/gallery/Tezgah1.webp" alt="">
                    </div>
                    <div class="slide">
                        <img src="img/gallery/Tezgah2.webp" alt="">
                    </div>
                    <div class="slide">
                        <img src="img/gallery/Tezgah3.webp" alt="">
                    </div>
                    <div class="navigation">
                        <div class="btn active"></div>
                        <div class="btn"></div>
                        <div class="btn"></div>
                    </div>
                </div>
            </div>

            <div class="project-item" style="margin-top: 15px;">
                <div class="project-info">
                    <h1>BASAMAK</h1>
