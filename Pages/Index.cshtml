@page
@model IndexModel
@{
    ViewData["Title"] = "Metaş Mermer";
    string companyName = Model.context.Heros.Select(h => h.CompanyName).FirstOrDefault()!;
    var service = Model.context.Services.FirstOrDefault();
    var about = Model.context.About.FirstOrDefault();
    string contactFirstPhoneNumber = Model.context.Contact.Where(c => c.Id == 1).Select(c => c.Value).FirstOrDefault()!;
    string contactSecondPhoneNumber = Model.context.Contact.Where(c => c.Id == 2).Select(c => c.Value).FirstOrDefault()!;
    string contactMail = Model.context.Contact.Where(c => c.Id == 3).Select(c => c.Value).FirstOrDefault()!;
    string contactAddressUrl = Model.context.Contact.Where(c => c.Id == 4).Select(c => c.Value).FirstOrDefault()!;
    string contactAddress = Model.context.Contact.Where(c => c.Id == 5).Select(c => c.Value).FirstOrDefault()!;
    string contactAddressMap = Model.context.Contact.Where(c => c.Id == 6).Select(c => c.Value).FirstOrDefault()!;
}

<!-- Hero Section  -->
<section id="hero" style="background-image: url(/img/anagoruntu.webp)">
    <div class="hero container">
        <div>
            <h1>Merhaba<span></span></h1>
            <h1>@companyName<span></span></h1>
            <h1>Hoşgeldiniz<span></span></h1>
            <a href="#contact" type="button" style="color:white;" class="cta">İLETİŞİM</a>
        </div>
    </div>
</section>
<!-- End Hero Section  -->

<!-- Service Section -->
<section id="services">
    <div class="services container2">
        <div class="service-top">
            <h1 class="section-title">@service.Title</h1>
            <p>
                @service.Desc
            </p>
        </div>
    </div>
</section>
<!-- End Service Section -->

<!-- Projects Section -->
